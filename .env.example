# Copy to .env.local.
# Base URL of dwi-api, reached from the Next.js server (never from the browser).
API_URL=http://localhost:8080
# Shown on the pairing page so organisers know where to open the scanner.
# Deployment: your scanner app's custom domain, e.g. scanner.themoments.id
NEXT_PUBLIC_SCANNER_URL=http://localhost:5173
# Base URL of dwi-api as the *browser* sees it (RSVP form, wishes wall). Inlined
# at build time; dwi-api's CORS_ORIGINS must include this site's origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
# Public pages render a built-in demo wedding (/e/alex-ajeng?to=AJ27-FAM-0001-2)
# when API_URL is unset, or whenever this is 1. PREVIEW_THEME=<theme key> picks its look.
# PREVIEW_MODE=1
